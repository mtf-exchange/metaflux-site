---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const DAY = 86_400_000;
const GENESIS = Date.UTC(2026, 8, 1, 15, 8);
const W1_END = Date.UTC(2026, 8, 9);
// The first Wednesday 00:00 UTC cut after this page goes live. Move it to 14 Oct if it ships after 7 Oct.
const S1_END = Date.UTC(2026, 9, 7);
const S2_END = S1_END + 56 * DAY;
const S3_END = S2_END + 56 * DAY;
const TGE = Date.UTC(2027, 2, 1);
const SPAN = TGE - GENESIS;

const seasons = [
  { n: 1, name: 'Ginnungagap', start: GENESIS, end: S1_END, weeks: String((S1_END - W1_END) / (7 * DAY) + 1), ceiling: 'At most 5,000,000 MTF' },
  { n: 2, name: 'Yggdrasil', start: S1_END, end: S2_END, weeks: '8', ceiling: 'At most 10,000,000 MTF' },
  { n: 3, name: 'Bifrost', start: S2_END, end: S3_END, weeks: '8', ceiling: 'Set at season start' },
  { n: 4, name: 'Ragnarok', start: S3_END, end: TGE, weeks: '', ceiling: 'Set at season start' },
].map((s) => ({ ...s, f0: (s.start - GENESIS) / SPAN, f1: (s.end - GENESIS) / SPAN }));

const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (t, y = true) => { const d = new Date(t); return `${d.getUTCDate()} ${MON[d.getUTCMonth()]}` + (y ? ` ${d.getUTCFullYear()}` : ''); };

// tge.js repeats this rule against the reader's clock.
const now = Date.now();
const current = [...seasons].reverse().find((s) => now >= s.start);
const next = seasons.find((s) => now < s.start);
const status = (s) => (s === current ? 'In progress' : now >= s.start ? 'Closed' : s.n === 4 ? 'Last' : s === next ? 'Next' : 'Later');

// Cubic Bezier with an arc-length table, so time maps to distance along the bow.
function bow(P, n = 1200) {
  const pts = [];
  const len = [0];
  for (let i = 0; i <= n; i++) {
    const t = i / n, u = 1 - t;
    const x = u * u * u * P[0] + 3 * u * u * t * P[2] + 3 * u * t * t * P[4] + t * t * t * P[6];
    const y = u * u * u * P[1] + 3 * u * u * t * P[3] + 3 * u * t * t * P[5] + t * t * t * P[7];
    if (i) len.push(len[i - 1] + Math.hypot(x - pts[i - 1][0], y - pts[i - 1][1]));
    pts.push([x, y]);
  }
  const total = len[n];
  const at = (f) => {
    const L = Math.min(Math.max(f, 0), 1) * total;
    const i = Math.max(1, len.findIndex((l) => l >= L));
    const [x0, y0] = pts[i - 1], [x1, y1] = pts[i];
    const k = (L - len[i - 1]) / (len[i] - len[i - 1] || 1);
    const m = Math.hypot(x1 - x0, y1 - y0) || 1;
    return { x: x0 + (x1 - x0) * k, y: y0 + (y1 - y0) * k, nx: (y1 - y0) / m, ny: -(x1 - x0) / m };
  };
  return { d: `M${P[0]} ${P[1]}C${P[2]} ${P[3]} ${P[4]} ${P[5]} ${P[6]} ${P[7]}`, at };
}

function art(id, W, H, P, band, rays, stars, seed) {
  const b = bow(P);
  let s = seed;
  const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
  const r1 = (v) => Math.round(v * 10) / 10;
  let starSvg = '';
  for (let i = 0; i < stars; i++) starSvg += `<circle cx="${r1(rnd() * W)}" cy="${r1(rnd() * H * 0.92)}" r="${r1(0.4 + rnd() * rnd() * 1.3)}" opacity="${r1(0.15 + rnd() * 0.6)}"/>`;
  let raySvg = '';
  const step = (W + 160) / rays;
  for (let i = 0; i < rays; i++) raySvg += `<rect x="${r1(-80 + i * step + rnd() * step)}" y="0" width="${r1(0.6 + rnd() * rnd() * 5)}" height="${H}" opacity="${r1(0.2 + rnd() * 0.8)}"/>`;
  const ticks = seasons.slice(0, 3).map((x) => {
    const p = b.at(x.f1), h = band * 0.55;
    return `<line x1="${r1(p.x - p.nx * h)}" y1="${r1(p.y - p.ny * h)}" x2="${r1(p.x + p.nx * h)}" y2="${r1(p.y + p.ny * h)}"/>`;
  }).join('');
  const end = b.at(1);
  const box = `x="-200" y="-300" width="${W + 400}" height="${H + 600}"`;
  const svg = `<svg class="bow" viewBox="0 0 ${W} ${H}" aria-hidden="true" focusable="false">
<defs>
<linearGradient id="g${id}" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="${W}" y2="0"><stop offset="0" stop-color="#5BCEFA"/><stop offset=".38" stop-color="#5BCEFA"/><stop offset=".62" stop-color="#cfc0e8"/><stop offset=".86" stop-color="#F5A9B8"/><stop offset="1" stop-color="#ffffff"/></linearGradient>
<filter id="wide${id}" ${box} filterUnits="userSpaceOnUse"><feGaussianBlur stdDeviation="${band * 0.5}"/></filter>
<filter id="soft${id}" ${box} filterUnits="userSpaceOnUse"><feGaussianBlur stdDeviation="${band * 0.14}"/></filter>
<filter id="edge${id}" ${box} filterUnits="userSpaceOnUse"><feGaussianBlur stdDeviation="1.6"/></filter>
<mask id="curtain${id}" maskUnits="userSpaceOnUse" ${box}>
<path d="${b.d}" fill="none" stroke="#fff" stroke-width="${band}" filter="url(#soft${id})"/>
<path d="${b.d}" fill="none" stroke="#fff" stroke-opacity=".5" stroke-width="${band * 1.6}" transform="translate(0 ${-band * 0.85})" filter="url(#wide${id})"/>
</mask>
<mask id="reveal${id}" maskUnits="userSpaceOnUse" ${box}><path class="draw" pathLength="1000" d="${b.d}" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="${band * 7}"/></mask>
</defs>
<g class="stars" fill="#e8f1f5">${starSvg}</g>
<g mask="url(#reveal${id})">
<path d="${b.d}" fill="none" stroke="url(#g${id})" stroke-width="${band * 2.6}" opacity=".2" filter="url(#wide${id})"/>
<g mask="url(#curtain${id})"><g class="rays" fill="url(#g${id})">${raySvg}</g></g>
<path d="${b.d}" fill="none" stroke="url(#g${id})" stroke-width="3" filter="url(#edge${id})"/>
<path class="ahead" d="${b.d}" fill="none" stroke="#e8f1f5" stroke-opacity=".55" stroke-width="1.2" stroke-dasharray="1.5 7" stroke-linecap="round"/>
<path class="past" pathLength="1000" d="${b.d}" fill="none" stroke="#fff" stroke-width="1.8" stroke-dasharray="0 1000"/>
<g class="ticks" stroke="#e8f1f5" stroke-opacity=".7" stroke-width="1.2">${ticks}</g>
<circle cx="${r1(end.x)}" cy="${r1(end.y)}" r="${band * 0.55}" fill="#fff" opacity=".22" filter="url(#soft${id})"/>
<circle cx="${r1(end.x)}" cy="${r1(end.y)}" r="5" fill="#fff"/>
</g>
<g class="now" style="display:none"><circle r="10" fill="#fff" opacity=".18"/><circle r="4.5" fill="#fff"/></g>
</svg>`;
  const pct = (p) => `left:${r1((p.x / W) * 1000) / 10}%;top:${r1((p.y / H) * 1000) / 10}%`;
  return { svg, b, pct };
}

const D = art('d', 1440, 820, [-70, 760, 230, 10, 1060, -60, 1240, 700], 64, 260, 140, 7);
const M = art('m', 390, 760, [16, 772, -24, -96, 414, -96, 374, 772], 34, 90, 60, 11);

// Season 1 sits inside the bow, and a narrow window pins it off the left edge.
const dLabels = seasons.map((x) => {
  const p = D.b.at((x.f0 + x.f1) / 2);
  const out = x.n === 1 ? -78 : 66;
  const style = D.pct({ x: p.x + p.nx * out, y: p.y + p.ny * out });
  return { ...x, style: x.n === 1 ? style.replace(/left:([\d.]+)%/, 'left:max($1%,100px)') : style };
});

const client = JSON.stringify({ GENESIS, W1_END, TGE, seasons: seasons.map(({ n, name, start }) => ({ n, name, start })) });
---
<Base
  title="MTF Points — MetaFlux"
  description="Testnet trading volume earns MTF points each week, counted from genesis. Four seasons, a public formula, and a claim at the TGE."
  canonical="https://mtf.exchange/tge.html"
  themeColor="#04141f"
  bodyClass="tge"
  script={false}
>
<Fragment slot="head">
<script type="application/json" id="pts-cfg" is:inline set:html={client}></script>
<script src="/tge.js" is:inline defer></script>
</Fragment>
<Nav current="tge" />

<header class="tge-hero">
  <div class="art art-d">
    <Fragment set:html={D.svg} />
    {dLabels.map((s) => (
      <div class="slab" style={s.style}><span class="sn">Season {s.n}</span><span class="nm">{s.name}</span><span class="from">{s.n === 1 ? 'From genesis, 1 Sep 2026' : `From ${day(s.start, false)}`}</span></div>
    ))}
    <div class="target foot-d" style={D.pct(D.b.at(1))}><span class="nm">Gimle</span><span class="date">TGE target · 1 March 2027</span><span class="may">The date may move.</span></div>
  </div>
  <div class="art art-m">
    <Fragment set:html={M.svg} />
    <div class="mfoot genesis"><span class="k">Genesis</span><span class="date">1 Sep 2026</span></div>
    <div class="target mfoot"><span class="nm">Gimle</span><span class="date">TGE target · 1 March 2027</span><span class="may">The date may move.</span></div>
  </div>
  <div class="copy">
    <p class="status"><span>Testnet points</span><span class="sep"> · </span><span>counted from genesis</span></p>
    <h1>MTF <em>Points</em></h1>
    <p class="lede">Trade on the testnet and earn points each week, counted from genesis. At the TGE, your points convert to&nbsp;MTF.</p>
    <p class="week"><span data-week>Weeks cut Wednesday 00:00 UTC</span><span class="cut" data-cut></span></p>
    <div class="ctas">
      <a class="btn" href="https://app.mtf.exchange/" target="_blank" rel="noopener">Trade on testnet <span aria-hidden="true">→</span></a>
      <a class="more" href="#formula">Read the formula</a>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="part" id="seasons" aria-labelledby="seasons-h">
    <h2 id="seasons-h">Four seasons, then Gimle.</h2>
    <p class="intro">A week closes every Wednesday at 00:00 UTC, and each week shares a pool of 1,000,000 points. Season 1 counts back from genesis and closes at the first weekly cut after this page went live. Season 4 ends at the TGE snapshot, so its last week is partial and its pool is 1,000,000 × whole hours / 168.</p>
    <p class="intro">The names come from Norse myth: the void, the world tree, the bridge, the end. The number is what the API and the tables use.</p>

    <table class="seasons">
      <thead><tr><th scope="col">Season</th><th scope="col">Window (UTC)</th><th scope="col">Weeks</th><th scope="col">MTF ceiling</th></tr></thead>
      <tbody>
        {seasons.map((s) => (
          <tr class={s === current ? 'is-now' : undefined}>
            <th scope="row"><span class="sn">{s.n}</span><span class="nm">{s.name}</span><span class="st" data-status={s.n}>{status(s)}</span></th>
            <td class="num">{s.n === 1 ? `${day(s.start)}, 15:08 UTC` : day(s.start)} → {s.n === 4 ? 'TGE snapshot' : day(s.end)}</td>
            <td class="num">{s.weeks ? <>{s.weeks}<span class="mo"> weeks</span></> : 'To the snapshot'}</td>
            <td class="ceil">{s.ceiling}</td>
          </tr>
        ))}
        <tr class="claim">
          <th scope="row"><span class="sn"></span><span class="nm">Gimle</span><span class="st">The claim</span></th>
          <td colspan="2">Opens at the TGE snapshot, on mainnet</td>
          <td class="ceil">At most 100,000,000 MTF in all</td>
        </tr>
      </tbody>
    </table>
  </section>

  <section class="part" id="formula" aria-labelledby="formula-h">
    <h2 id="formula-h">One pool a week, shared pro rata.</h2>
    <div class="glass formula">
      <div class="eqn" role="math" aria-label="points equals 1,000,000 times qv, divided by the larger of the sum of all qv and Q floor">
        <span class="lhs"><i>points</i> =</span>
        <span class="frac"><span><b>1,000,000</b> × <i>qv</i></span><span>max(<span class="sig">Σ</span><i>qv</i>, <i>Q</i><sub>floor</sub>)</span></span>
      </div>
      <p class="plain"><code><span>points = 1,000,000 × qv</span> <span>/ max(Σqv, Q_floor)</span></code></p>
      <dl class="terms">
        <div><dt><i>qv</i></dt><dd>Your qualifying volume for the week, in USD.</dd></div>
        <div><dt><span class="sig">Σ</span><i>qv</i></dt><dd>The qualifying volume of all accounts for the week.</dd></div>
        <div><dt><i>Q</i><sub>floor</sub></dt><dd>$50,000,000, published for each season. In a thin week it limits what $1 can earn: at most 0.02 points.</dd></div>
        <div><dt>Rounding</dt><dd>Toward zero, to one millionth of a point.</dd></div>
      </dl>
    </div>
    <p class="aside">There is no cap per account. The share is linear, so ten accounts earn what one account earns with the same volume.</p>

    <h3>A worked week</h3>
    <p class="aside">One account, one week, with fills more than 24 hours apart.</p>
    <dl class="ladder num">
      <div><dt>Raw volume</dt><dd>$3,000,000</dd></div>
      <div><dt>Of it, against one counterparty cluster</dt><dd>$1,100,000</dd></div>
      <div><dt>25% of raw, the limit for that cluster</dt><dd>$750,000</dd></div>
      <div><dt>Volume above the limit</dt><dd>−$350,000</dd></div>
      <div class="sum"><dt>Qualifying volume, <i>qv</i></dt><dd>$2,650,000</dd></div>
    </dl>
    <div class="example">
      <div class="wk">
        <h4>A busy week</h4>
        <dl class="num">
          <div><dt>All qualifying volume, <span class="sig">Σ</span><i>qv</i></dt><dd>$200,000,000</dd></div>
          <div><dt>Divisor, the larger of <span class="sig">Σ</span><i>qv</i> and <i>Q</i><sub>floor</sub></dt><dd>$200,000,000</dd></div>
          <div class="res"><dt>Points<span class="calc">1,000,000 × 2,650,000 / 200,000,000</span></dt><dd>13,250</dd></div>
          <div><dt>Pool issued</dt><dd>1,000,000 of 1,000,000</dd></div>
        </dl>
      </div>
      <div class="wk">
        <h4>A thin week</h4>
        <dl class="num">
          <div><dt>All qualifying volume, <span class="sig">Σ</span><i>qv</i></dt><dd>$8,000,000</dd></div>
          <div><dt>Divisor, the larger of <span class="sig">Σ</span><i>qv</i> and <i>Q</i><sub>floor</sub></dt><dd>$50,000,000</dd></div>
          <div class="res"><dt>Points<span class="calc">1,000,000 × 2,650,000 / 50,000,000</span></dt><dd>53,000</dd></div>
          <div><dt>Pool issued</dt><dd>160,000 of 1,000,000</dd></div>
        </dl>
        <p class="note">The rest is not issued. No MTF is paid for it.</p>
      </div>
    </div>
  </section>

  <section class="part" id="budget" aria-labelledby="budget-h">
    <h2 id="budget-h">A ceiling, not a promise.</h2>
    <p class="intro">MTF has a fixed supply of 1,000,000,000. The community allocation is 30% of it, 300,000,000 MTF. The points program pays at most 100,000,000 MTF of that across all four seasons, and the rate is set at the TGE, under each season's ceiling.</p>
    <figure class="alloc">
      <div class="bar-head"><span>Community allocation</span><span class="num">300,000,000 MTF</span></div>
      <div class="bar" role="img" aria-label="Of the 300,000,000 MTF community allocation, at most 100,000,000 goes to the points program and 200,000,000 stays reserved.">
        <span class="prog" style="flex-grow:100"></span><span class="rsv" style="flex-grow:200"></span>
      </div>
      <dl class="legend">
        <div><dt><i class="sw prog"></i>Points program ceiling</dt><dd class="num">At most 100,000,000 MTF</dd></div>
        <div><dt><i class="sw rsv"></i>Reserved</dt><dd><span class="num">200,000,000 MTF</span>. No use is assigned.</dd></div>
      </dl>
      <svg class="zoom" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path d="M0 0 L100 0 L300 100 L0 100 Z" fill="url(#zoomfill)"/>
        <path d="M100 0 L300 100" fill="none" stroke="rgba(91,206,250,.35)" vector-effect="non-scaling-stroke"/>
        <defs><linearGradient id="zoomfill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5BCEFA" stop-opacity=".16"/><stop offset="1" stop-color="#5BCEFA" stop-opacity=".02"/></linearGradient></defs>
      </svg>
      <div class="bar-head"><span>Points program ceiling</span><span class="num">100,000,000 MTF</span></div>
      <div class="bar" role="img" aria-label="Of the 100,000,000 MTF program ceiling, Season 1 takes at most 5,000,000 and Season 2 at most 10,000,000. Seasons 3 and 4 get their ceilings at season start.">
        <span class="s1" style="flex-grow:5"></span><span class="s2" style="flex-grow:10"></span><span class="s34" style="flex-grow:85"></span>
      </div>
      <dl class="legend">
        <div><dt><i class="sw s1"></i>Season 1</dt><dd class="num">At most 5,000,000 MTF</dd></div>
        <div><dt><i class="sw s2"></i>Season 2</dt><dd class="num">At most 10,000,000 MTF</dd></div>
        <div><dt><i class="sw s34"></i>Seasons 3 and 4</dt><dd>Set at season start, inside the ceiling</dd></div>
      </dl>
    </figure>
    <div class="glass rate">
      <p class="fx"><span>MTF per point ≤ season ceiling</span> <span>/ (weeks × 1,000,000)</span></p>
      <p>Season 2, for example: 10,000,000 / (8 × 1,000,000), so <b class="num">at most 1.25 MTF per point</b>. Points that are not issued are not paid. Their MTF stays reserved.</p>
    </div>
  </section>

  <section class="part" id="rules" aria-labelledby="rules-h">
    <h2 id="rules-h">What counts.</h2>
    <div class="cols">
      <div>
        <h3>A fill qualifies when all five hold</h3>
        <ol class="steps">
          <li>The market is a governance-listed perp. Spot markets, builder-deployed (MIP-3) markets, options and the MTF perp do not count.</li>
          <li>The fill is not a liquidation.</li>
          <li>The price is inside the market's 1-minute mark bar, ±1%: <code>0.99 × low ≤ px ≤ 1.01 × high</code>. A minute with no bar uses the latest earlier bar.</li>
          <li>The two sides have different root accounts, and they are not in one cluster.</li>
          <li>Neither side is excluded. One exception: a fill against protocol vault id 1 counts for the other side when that side is the taker.</li>
        </ol>
      </div>
      <div>
        <h3>Your qualifying volume, each week</h3>
        <ol class="steps">
          <li>Raw volume is the notional of your qualifying fills. Maker and taker fills count the same.</li>
          <li>Volume against one counterparty cluster counts up to 25% of raw. Protocol vault id 1 is exempt.</li>
          <li>Qualifying volume is raw volume minus the volume above that limit.</li>
          <li>Under $1,000, or with first and last fills less than 24 hours apart, the week's qualifying volume is zero.</li>
        </ol>
      </div>
    </div>

    <h3 class="rules-h">The rules</h3>
    <dl class="rules">
      <div><dt>Scope</dt><dd>Only trading volume on the testnet earns points. Mainnet activity earns none.</dd></div>
      <div><dt>Root account</dt><dd>A sub-account earns as its parent, and a user vault as its leader. A fill between a root and its own sub-account or vault earns nothing.</dd></div>
      <div><dt>Exclusion</dt><dd>Protocol accounts, validators, protocol vaults and accounts operated by the MetaFlux team earn no points.</dd></div>
      <div><dt>Cluster</dt><dd>Two roots are one cluster when one of these links them: transfers in both directions between them, above a threshold; one agent wallet that signs for both; a fill between them outside the mark band; a closed trading group, where most of each member's volume is against the other members. A link one side makes alone, such as a small transfer to someone else's account, never joins two accounts. Faucet grants never link accounts. A fill inside a cluster earns nothing, and the 25% rule counts a cluster as one counterparty.</dd></div>
      <div><dt>Referrals</dt><dd>A referrer gets no share of a referee's points.</dd></div>
      <div><dt>Eligibility</dt><dd>Claims are screened at the TGE against sanctions lists and the <a href="/terms.html">Terms</a>. UK retail consumers are excluded from crypto-derivatives. IP data serves screening only, never scoring.</dd></div>
      <div><dt>Final review</dt><dd>Weekly numbers are provisional. One review at the TGE snapshot may remove points for abuse. Removed points are not paid.</dd></div>
    </dl>
  </section>

  <section class="part" id="points" aria-labelledby="points-h">
    <h2 id="points-h">Your points.</h2>
    <div class="cols check">
      <form class="glass lookup" data-lookup novalidate>
        <label for="addr">Address</label>
        <input id="addr" name="address" type="text" autocomplete="off" spellcheck="false" placeholder="0x…" />
        <div class="row">
          <label class="sr" for="season">Season</label>
          <select id="season" name="season">
            {seasons.map((s) => <option value={s.n} selected={s === current}>Season {s.n}, {s.name}</option>)}
          </select>
          <button class="btn" type="submit">Look up</button>
        </div>
        <div class="out" data-out aria-live="polite"></div>
      </form>
      <div class="about">
        <p>The lookup shows your raw volume, qualifying volume and points for each week of a season. A sub-account or a user vault reads as its root.</p>
        <p>The archive publishes these as <code>points_weeks</code>, <code>points_leaderboard</code> and <code>points_user</code>; the <a href="https://docs.mtf.exchange/api">docs</a> describe them.</p>
      </div>
    </div>

    <h3>Published weeks</h3>
    <p class="aside">A published week never changes. Its table has a row for each root account with raw volume, except excluded accounts. Download a week to get that table. The file is the exact text that the table SHA-256 covers, and the page compares the two when the download ends. The <a href="https://docs.mtf.exchange/concepts/points#how-to-check">docs</a> show how to recompute a row. Gap blocks are blocks the archive misses in that week. The pool stays the same.</p>
    <table class="weeks">
      <thead><tr><th scope="col">Week ending</th><th scope="col">Season</th><th scope="col" class="r">Qualifying volume</th><th scope="col" class="r">Issued points</th><th scope="col" class="r">Gap blocks</th><th scope="col">Table SHA-256</th></tr></thead>
      <tbody data-weeks><tr class="st"><td colspan="6">Reading the archive…</td></tr></tbody>
    </table>
  </section>

  <section class="part" id="gimle" aria-labelledby="gimle-h">
    <h2 id="gimle-h">Gimle, the claim.</h2>
    <div class="prose">
      <p class="when">TGE target: <time datetime="2027-03-01">1 March 2027</time>. The date may move.</p>
      <p>Gimle opens at the TGE, on mainnet. Each root account claims the MTF for its points.</p>
      <p>The rate is set at the TGE. It never exceeds the season ceiling divided by the season's possible points. The points allocation is fully claimable at the TGE, with an optional lock bonus that the <a href="https://docs.mtf.exchange/concepts/tokenomics">tokenomics page</a> describes.</p>
