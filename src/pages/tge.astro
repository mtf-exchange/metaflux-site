---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const DAY = 86_400_000;
const GENESIS = Date.UTC(2026, 8, 1, 15, 8);
const W1_END = Date.UTC(2026, 8, 9);
const S1_END = Date.UTC(2026, 9, 7);
const S2_END = S1_END + 56 * DAY;
const S3_END = S2_END + 56 * DAY;
const TGE = Date.UTC(2027, 2, 1);
const SPAN = TGE - GENESIS;

const seasons = [
  { n: 1, name: 'Ginnungagap', runes: 'ᚴᛁᚾᚢᚴᛅᚴᛅᛒ', start: GENESIS, end: S1_END, weeks: String((S1_END - W1_END) / (7 * DAY) + 1), ceiling: 'At most 5,000,000 MTF' },
  { n: 2, name: 'Yggdrasil', runes: 'ᚢᚴᛏᚱᛅᛋᛁᛚ', start: S1_END, end: S2_END, weeks: '8', ceiling: 'At most 10,000,000 MTF' },
  { n: 3, name: 'Bifrost', runes: 'ᛒᛁᚠᚱᚢᛋᛏ', start: S2_END, end: S3_END, weeks: '8', ceiling: 'Set at season start' },
  { n: 4, name: 'Ragnarok', runes: 'ᚱᛅᚴᚾᛅᚱᚢᚴ', start: S3_END, end: TGE, weeks: '', ceiling: 'Set at season start' },
].map((s) => ({ ...s, f0: (s.start - GENESIS) / SPAN, f1: (s.end - GENESIS) / SPAN }));

const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const day = (t, y = true) => { const d = new Date(t); return `${d.getUTCDate()} ${MON[d.getUTCMonth()]}` + (y ? ` ${d.getUTCFullYear()}` : ''); };

// tge.js repeats this rule against the reader's clock.
const now = Date.now();
const current = [...seasons].reverse().find((s) => now >= s.start);
const next = seasons.find((s) => now < s.start);
const status = (s) => (s === current ? 'In progress' : now >= s.start ? 'Closed' : s.n === 4 ? 'Last' : s === next ? 'Next' : 'Later');

// The stone, in a 600 x 1000 box. Each row is one cubic: x0 y0, two control points, x1 y1.
const SLAB = [[30, 1000, 14, 840, 4, 640, 18, 420], [18, 420, 30, 230, 120, 40, 262, 26], [262, 26, 420, 12, 548, 110, 576, 290], [576, 290, 600, 450, 596, 780, 578, 1000]];
const TRACK = [[92, 940, 80, 800, 70, 620, 82, 440], [82, 440, 94, 270, 170, 104, 270, 94], [270, 94, 400, 82, 492, 170, 514, 320], [514, 320, 534, 460, 530, 760, 516, 940]];
const pathD = (segs) => `M${segs[0][0]} ${segs[0][1]}` + segs.map((s) => `C${s.slice(2).join(' ')}`).join('');
const TAIL = 'M67 938C67 964 84 984 98 996C104 976 117 958 117 938Z';
const HEAD = 'M490 936C480 962 499 990 515 996C531 990 552 962 542 936Z';
// Time fills this share of the band from the tail. The rest, up to the head, is Gimle.
const TIME = 0.86;
const BAND = 50;

// Arc-length table, so a time fraction maps to a distance along the band.
function track(segs, n = 400) {
  const pts = [];
  for (const P of segs) for (let i = pts.length ? 1 : 0; i <= n; i++) {
    const t = i / n, u = 1 - t;
    pts.push([u * u * u * P[0] + 3 * u * u * t * P[2] + 3 * u * t * t * P[4] + t * t * t * P[6], u * u * u * P[1] + 3 * u * u * t * P[3] + 3 * u * t * t * P[5] + t * t * t * P[7]]);
  }
  const len = [0];
  for (let i = 1; i < pts.length; i++) len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  const total = len[len.length - 1];
  return (f) => {
    const L = Math.min(Math.max(f, 0), 1) * total;
    const i = Math.max(1, len.findIndex((l) => l >= L));
    const [x0, y0] = pts[i - 1], [x1, y1] = pts[i];
    const k = (L - len[i - 1]) / (len[i] - len[i - 1] || 1);
    const m = Math.hypot(x1 - x0, y1 - y0) || 1;
    return { x: x0 + (x1 - x0) * k, y: y0 + (y1 - y0) * k, nx: (y1 - y0) / m, ny: -(x1 - x0) / m };
  };
}
const at = track(TRACK);
const r1 = (v) => Math.round(v * 10) / 10;
const pct = (f) => `${r1(f * 1000) / 10}%`;

const ticks = [...seasons.map((s) => s.f1)].map((f) => {
  const p = at(f * TIME), h = BAND / 2;
  return { x1: r1(p.x - p.nx * h), y1: r1(p.y - p.ny * h), x2: r1(p.x + p.nx * h), y2: r1(p.y + p.ny * h) };
});
const inscriptions = [
  ...seasons.map((s) => ({ text: s.runes, at: pct(((s.f0 + s.f1) / 2) * TIME) })),
  { text: 'ᚴᛁᛘᛚᛁ', at: pct((TIME + 1) / 2) },
];

const OUT = 92;
const side = (p) => (Math.abs(p.ny) > 0.85 ? 't' : (p.nx < 0 ? 'l' : 'r') + (p.ny < -0.4 ? ' up' : ''));
const place = (p) => ({ cls: side(p), style: `left:${r1((p.x + p.nx * OUT) / 6)}%;top:${r1((p.y + p.ny * OUT) / 10)}%` });
const range = (s) => (s.n === 4 ? `${day(s.start)} – TGE` : `${day(s.start, false)} – ${day(s.end)}`);
const labels = seasons.map((s) => ({ ...s, ...place(at(((s.f0 + s.f1) / 2) * TIME)), range: range(s) }));
const gimle = place(at(1));

const fNow = Math.min(Math.max((now - GENESIS) / SPAN, 0), 1);
const mark = at(fNow * TIME);

const client = JSON.stringify({ GENESIS, W1_END, TGE, seasons: seasons.map(({ n, name, start }) => ({ n, name, start })) });
---
<Base
  title="MTF Points — MetaFlux"
  description="Testnet trading volume earns MTF points each week, counted from genesis. Four seasons, a public formula, and a claim at the TGE."
  canonical="https://mtf.exchange/tge.html"
  themeColor="#0b0c0e"
  bodyClass="tge"
  script={false}
>
<Fragment slot="head">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+Runic&family=Source+Serif+4:ital,opsz,wght@1,8..60,300..400&display=swap">
</Fragment>
<Nav current="tge" overlay />

<header class="stone-hero dark" aria-labelledby="pts-h">
  <div class="wrap">
    <div class="copy">
      <h1 id="pts-h">MTF Points</h1>
      <p class="lede">Testnet trading earns points every week, counted from genesis, and at the TGE your points convert to MTF.</p>
      <div class="live">
        <p class="week" data-week>Weeks cut Wednesday 00:00 UTC</p>
        <div class="cd num" role="timer" aria-label="Time to the next weekly cut" hidden>
          <div><b data-cd="d">0</b><span>days</span></div>
          <div><b data-cd="h">00</b><span>hours</span></div>
          <div><b data-cd="m">00</b><span>minutes</span></div>
          <div><b data-cd="s">00</b><span>seconds</span></div>
        </div>
        <p class="cut" data-cut></p>
      </div>
      <div class="ctas">
        <a class="pill solid" href="https://app.mtf.exchange/" target="_blank" rel="noopener">Trade on testnet</a>
        <a class="pill line" href="#formula">Read the formula</a>
      </div>
    </div>

    <div class="art">
      <div class="stone">
        <div class="slab-box">
          <canvas aria-hidden="true"></canvas>
          <svg class="band" viewBox="0 0 600 1000" data-span={TIME} aria-hidden="true" focusable="false">
            <defs>
              <path id="rs-slab" d={pathD(SLAB) + 'Z'} />
              <mask id="rs-lit" maskUnits="userSpaceOnUse" x="-50" y="-50" width="700" height="1100">
                <path class="lit-mask" d={pathD(TRACK)} pathLength="1000" fill="none" stroke="#fff" stroke-width="90" stroke-dasharray={`${r1(fNow * TIME * 1000)} 1000`} />
              </mask>
            </defs>
            <path id="rs-track" d={pathD(TRACK)} fill="none" />
            {['dim', 'lit'].map((k) => (
              <g class={k} mask={k === 'lit' ? 'url(#rs-lit)' : undefined}>
                <path d={pathD(TRACK)} fill="none" stroke="currentColor" stroke-width={BAND + 3} stroke-opacity=".7" />
                <path d={pathD(TRACK)} fill="none" stroke="#0b0c0e" stroke-width={BAND} />
                <g stroke="currentColor" stroke-width="1.6" stroke-opacity=".7">{ticks.map((t) => <line {...t} />)}</g>
                {inscriptions.map((w) => (
                  <text class="runes" text-anchor="middle" dominant-baseline="central"><textPath href="#rs-track" startOffset={w.at}>᛬{w.text}᛬</textPath></text>
                ))}
              </g>
            ))}
            <path class="end tail" d={TAIL} />
            <path class="end head" d={HEAD} />
            <circle class="eye" cx="527" cy="961" r="3.5" />
            <g class="now" transform={`translate(${r1(mark.x)} ${r1(mark.y)})`}><circle r="15" /><circle r="6" /></g>
          </svg>
        </div>
        <ol class="segs" aria-label="Seasons on the stone">
          {labels.map((s) => (
            <li class={`seg ${s.cls}${s.n === current?.n ? ' is-now' : ''}`} data-seg={s.n} style={s.style}><span class="sn">Season {s.n}</span><span class="nm">{s.name}</span><span class="dt">{s.range}</span></li>
          ))}
          <li class={`seg gimle ${gimle.cls}`} style={gimle.style}><span class="nm">Gimle</span><span class="dt">TGE target 1&nbsp;March&nbsp;2027</span><span class="may">The date may move.</span></li>
        </ol>
      </div>
    </div>
  </div>
</header>

<main>
  <section class="light sec tight" id="seasons" aria-labelledby="seasons-h">
    <div class="wrap">
      <div class="label">Seasons</div>
      <h2 id="seasons-h">Four seasons, then Gimle.</h2>
      <p class="intro">A week closes every Wednesday at 00:00 UTC, and each week shares a pool of 1,000,000 points. Season 1 counts back from genesis and closes at the 7 October cut. Season 4 ends at the TGE snapshot, so its last week is partial and its pool is 1,000,000 × whole hours / 168.</p>
      <p class="intro">The names come from Norse myth: the void, the world tree, the bridge, the end. The number is what the API and the tables use.</p>

      <table class="seasons">
        <thead><tr><th scope="col">Season</th><th scope="col">Window (UTC)</th><th scope="col">Weeks</th><th scope="col">MTF ceiling</th></tr></thead>
        <tbody>
          {seasons.map((s) => (
            <tr class={s === current ? 'is-now' : undefined}>
              <th scope="row"><span class="sn">{s.n}</span><span class="nm">{s.name}</span><span class="st" data-status={s.n}>{status(s)}</span></th>
              <td class="num">{s.n === 1 ? `${day(s.start)}, 15:08 UTC` : day(s.start)} → {s.n === 4 ? 'TGE snapshot' : day(s.end)}</td>
              <td class="num">{s.weeks ? <>{s.weeks}<span class="mo"> weeks</span></> : 'To the snapshot'}</td>
              <td class="ceil">{s.ceiling}</td>
            </tr>
          ))}
          <tr class="claim">
            <th scope="row"><span class="sn"></span><span class="nm">Gimle</span><span class="st">The claim</span></th>
            <td colspan="2">Opens at the TGE snapshot, on mainnet</td>
            <td class="ceil">At most 100,000,000 MTF in all</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="light sec tight" id="formula" aria-labelledby="formula-h">
    <div class="wrap">
      <div class="label">Formula</div>
      <h2 id="formula-h">One pool a week, shared pro rata.</h2>
      <div class="panel formula">
        <div class="eqn" role="math" aria-label="points equals 1,000,000 times qv, divided by the larger of the sum of all qv and Q floor">
          <span class="lhs"><i>points</i> =</span>
          <span class="frac"><span><b>1,000,000</b> × <i>qv</i></span><span>max(Σ<i>qv</i>, <i>Q</i><sub>floor</sub>)</span></span>
        </div>
        <p class="plain"><code><span>points = 1,000,000 × qv</span> <span>/ max(Σqv, Q_floor)</span></code></p>
        <dl class="terms">
          <div><dt><i>qv</i></dt><dd>Your qualifying volume for the week, in USD.</dd></div>
          <div><dt>Σ<i>qv</i></dt><dd>The qualifying volume of all accounts for the week.</dd></div>
          <div><dt><i>Q</i><sub>floor</sub></dt><dd>$50,000,000, published for each season. In a thin week it limits what $1 can earn: at most 0.02 points.</dd></div>
          <div><dt>Rounding</dt><dd>Toward zero, to one millionth of a point.</dd></div>
        </dl>
      </div>
      <p class="aside">There is no cap per account. The share is linear, so ten accounts earn what one account earns with the same volume.</p>

      <h3>A worked week</h3>
      <p class="aside">One account, one week, with fills more than 24 hours apart.</p>
      <dl class="ladder num">
        <div><dt>Raw volume</dt><dd>$3,000,000</dd></div>
        <div><dt>Of it, against one counterparty cluster</dt><dd>$1,100,000</dd></div>
        <div><dt>25% of raw, the limit for that cluster</dt><dd>$750,000</dd></div>
        <div><dt>Volume above the limit</dt><dd>−$350,000</dd></div>
        <div class="sum"><dt>Qualifying volume, <i>qv</i></dt><dd>$2,650,000</dd></div>
      </dl>
      <div class="example">
        <div class="wk">
          <h4>A busy week</h4>
          <dl class="num">
            <div><dt>All qualifying volume, Σ<i>qv</i></dt><dd>$200,000,000</dd></div>
            <div><dt>Divisor, the larger of Σ<i>qv</i> and <i>Q</i><sub>floor</sub></dt><dd>$200,000,000</dd></div>
            <div class="res"><dt>Points<span class="calc">1,000,000 × 2,650,000 / 200,000,000</span></dt><dd>13,250</dd></div>
            <div><dt>Pool issued</dt><dd>1,000,000 of 1,000,000</dd></div>
          </dl>
        </div>
        <div class="wk">
          <h4>A thin week</h4>
          <dl class="num">
            <div><dt>All qualifying volume, Σ<i>qv</i></dt><dd>$8,000,000</dd></div>
            <div><dt>Divisor, the larger of Σ<i>qv</i> and <i>Q</i><sub>floor</sub></dt><dd>$50,000,000</dd></div>
            <div class="res"><dt>Points<span class="calc">1,000,000 × 2,650,000 / 50,000,000</span></dt><dd>53,000</dd></div>
            <div><dt>Pool issued</dt><dd>160,000 of 1,000,000</dd></div>
          </dl>
          <p class="note">The rest is not issued. No MTF is paid for it.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="light sec tight" id="budget" aria-labelledby="budget-h">
    <div class="wrap">
      <div class="label">Allocation</div>
      <h2 id="budget-h">A ceiling, not a promise.</h2>
      <p class="intro">MTF has a fixed supply of 1,000,000,000. The community allocation is 30% of it, 300,000,000 MTF. The points program pays at most 100,000,000 MTF of that across all four seasons, and the rate is set at the TGE, under each season's ceiling.</p>
      <figure class="alloc">
        <div class="bar-head"><span>Community allocation</span><span class="num">300,000,000 MTF</span></div>
        <div class="bar" role="img" aria-label="Of the 300,000,000 MTF community allocation, at most 100,000,000 goes to the points program and 200,000,000 stays reserved.">
          <span class="ink" style="flex-grow:100"></span><span class="grey" style="flex-grow:200"></span>
        </div>
        <dl class="legend">
          <div><dt><i class="sw ink"></i>Points program ceiling</dt><dd class="num">At most 100,000,000 MTF</dd></div>
          <div><dt><i class="sw grey"></i>Reserved</dt><dd><span class="num">200,000,000 MTF</span>. No use is assigned.</dd></div>
        </dl>
        <svg class="zoom" viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
          <path d="M0 0 L100 0 L300 100 L0 100 Z" />
          <path class="edge" d="M100 0 L300 100" vector-effect="non-scaling-stroke" />
        </svg>
        <div class="bar-head"><span>Points program ceiling</span><span class="num">100,000,000 MTF</span></div>
        <div class="bar" role="img" aria-label="Of the 100,000,000 MTF program ceiling, Season 1 takes at most 5,000,000 and Season 2 at most 10,000,000. Seasons 3 and 4 get their ceilings at season start.">
          <span class="ink" style="flex-grow:5"></span><span class="grey" style="flex-grow:10"></span><span class="hatch" style="flex-grow:85"></span>
        </div>
        <dl class="legend">
          <div><dt><i class="sw ink"></i>Season 1</dt><dd class="num">At most 5,000,000 MTF</dd></div>
          <div><dt><i class="sw grey"></i>Season 2</dt><dd class="num">At most 10,000,000 MTF</dd></div>
          <div><dt><i class="sw hatch"></i>Seasons 3 and 4</dt><dd>Set at season start, inside the ceiling</dd></div>
        </dl>
      </figure>
      <div class="panel rate">
        <p class="fx"><span>MTF per point ≤ season ceiling</span> <span>/ (weeks × 1,000,000)</span></p>
        <p>Season 2, for example: 10,000,000 / (8 × 1,000,000), so <b class="num">at most 1.25 MTF per point</b>. Points that are not issued are not paid. Their MTF stays reserved.</p>
      </div>
    </div>
  </section>

  <section class="light sec tight" id="rules" aria-labelledby="rules-h">
    <div class="wrap">
      <div class="label">Rules</div>
      <h2 id="rules-h">What counts.</h2>
      <div class="cols">
        <div>
          <h3>A fill qualifies when all five hold</h3>
          <ol class="steps">
            <li>The market is a governance-listed perp. Spot markets, builder-deployed (MIP-3) markets, options and the MTF perp do not count.</li>
            <li>The fill is not a liquidation.</li>
            <li>The price is inside the market's 1-minute mark bar, ±1%: <code>0.99 × low ≤ px ≤ 1.01 × high</code>. A minute with no bar uses the latest earlier bar.</li>
            <li>The two sides have different root accounts, and they are not in one cluster.</li>
            <li>Neither side is excluded. One exception: a fill against protocol vault id 1 counts for the other side when that side is the taker.</li>
          </ol>
        </div>
        <div>
          <h3>Your qualifying volume, each week</h3>
          <ol class="steps">
            <li>Raw volume is the notional of your qualifying fills. Maker and taker fills count the same.</li>
            <li>Volume against one counterparty cluster counts up to 25% of raw. Protocol vault id 1 is exempt.</li>
            <li>Qualifying volume is raw volume minus the volume above that limit.</li>
            <li>Under $1,000, or with first and last fills less than 24 hours apart, the week's qualifying volume is zero.</li>
          </ol>
        </div>
      </div>

      <h3 class="rules-h">The rules</h3>
      <div class="faq rules">
        <details><summary>Scope</summary><p>Only trading volume on the testnet earns points. Mainnet activity earns none.</p></details>
        <details><summary>Root account</summary><p>A sub-account earns as its parent, and a user vault as its leader. A fill between a root and its own sub-account or vault earns nothing.</p></details>
        <details><summary>Exclusion</summary><p>Protocol accounts, validators, protocol vaults and accounts operated by the MetaFlux team earn no points.</p></details>
        <details><summary>Cluster</summary><p>Two roots are one cluster when one of these links them: transfers in both directions between them, above a threshold; one agent wallet that signs for both; a closed trading group, where most of each member's volume is against the other members. A link one side makes alone, such as a small transfer to someone else's account, never joins two accounts. Faucet grants never link accounts. A fill inside a cluster earns nothing, and the 25% rule counts a cluster as one counterparty.</p></details>
        <details><summary>Referrals</summary><p>A referrer gets no share of a referee's points.</p></details>
        <details><summary>Eligibility</summary><p>Claims are screened at the TGE against sanctions lists and the <a href="/terms.html">Terms</a>. IP data serves screening only, never scoring.</p></details>
        <details><summary>Final review</summary><p>Weekly numbers are provisional. One review at the TGE snapshot may remove points for abuse. Removed points are not paid.</p></details>
      </div>
    </div>
  </section>

  <section class="light sec tight" id="points" aria-labelledby="points-h">
    <div class="wrap">
      <div class="label">Lookup</div>
      <h2 id="points-h">Your points.</h2>
      <div class="cols check">
        <form class="panel lookup" data-lookup novalidate>
          <label for="addr">Address</label>
          <input id="addr" name="address" type="text" autocomplete="off" spellcheck="false" placeholder="0x…" />
          <div class="lk-row">
            <label class="sr" for="season">Season</label>
            <select id="season" name="season">
              {seasons.map((s) => <option value={s.n} selected={s === current}>Season {s.n}, {s.name}</option>)}
            </select>
            <button class="pill solid" type="submit">Look up</button>
          </div>
          <div class="out" data-out aria-live="polite"></div>
        </form>
        <div class="about">
          <p>The lookup shows your raw volume, qualifying volume and points for each week of a season. A sub-account or a user vault reads as its root.</p>
          <p>The archive publishes these as <code>points_weeks</code>, <code>points_leaderboard</code> and <code>points_user</code>; the <a href="https://docs.mtf.exchange/api">docs</a> describe them.</p>
        </div>
      </div>

      <h3>Published weeks</h3>
      <p class="aside">A published week never changes. Its table has a row for each root account with raw volume, except excluded accounts. Download a week to get that table. The file is the exact text that the table SHA-256 covers, and the page compares the two when the download ends. The <a href="https://docs.mtf.exchange/concepts/points#how-to-check">docs</a> show how to recompute a row. Gap blocks are blocks the archive misses in that week. The pool stays the same.</p>
      <div class="scroll">
        <table class="weeks">
          <thead><tr><th scope="col">Week ending</th><th scope="col">Season</th><th scope="col" class="r">Qualifying volume</th><th scope="col" class="r">Issued points</th><th scope="col" class="r">Gap blocks</th><th scope="col">Table SHA-256</th></tr></thead>
          <tbody data-weeks><tr class="st"><td colspan="6">Reading the archive…</td></tr></tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="dark sec claim-band" id="gimle" aria-labelledby="gimle-h">
    <div class="wrap">
      <div>
        <div class="label">The claim</div>
        <h2 id="gimle-h">Gimle, the claim.</h2>
        <p class="when"><span>TGE target</span><time datetime="2027-03-01">1 March 2027</time><span>The date may move.</span></p>
      </div>
      <div class="prose">
        <p>Gimle opens at the TGE, on mainnet. Each root account claims the MTF for its points.</p>
        <p>The rate is set at the TGE. It never exceeds the season ceiling divided by the season's possible points. The points allocation is fully claimable at the TGE, with an optional lock bonus that the <a href="https://docs.mtf.exchange/concepts/tokenomics">tokenomics page</a> describes.</p>
        <p>Before payment, each claim is screened against sanctions lists and the <a href="/terms.html">Terms</a>.</p>
        <a class="pill solid" href="https://app.mtf.exchange/" target="_blank" rel="noopener">Trade on testnet</a>
      </div>
    </div>
  </section>
</main>

