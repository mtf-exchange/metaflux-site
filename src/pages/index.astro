          <li><a href="https://x.com/MetaFluxDex" target="_blank" rel="noopener">X / Twitter</a></li>
          <li><a href="https://github.com/mtf-exchange" target="_blank" rel="noopener">GitHub</a></li>
          <li><a href="mailto:hello@mtf.exchange">hello@mtf.exchange</a></li>
          <li><a href="mailto:validators@mtf.exchange?subject=Validator%20inquiry">Validator inquiry</a></li>
        </ul>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 MetaFlux Foundation, established in England &amp; Wales. Pre-launch. · <a href="/terms.html">Terms</a> · <a href="/privacy.html">Privacy</a></span>
      <span>mtf.exchange</span>
    </div>
  </div>
  <div class="wordmark reveal" aria-hidden="true">Meta<em>Flux</em></div>
</footer>
</Base>
