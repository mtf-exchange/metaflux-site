---
// The one <head> for the whole site. Every page's meta, fonts and icons come
// from here — before this existed the four pages had drifted apart (different
// font URLs, a dead favicon.ico, no OG tags on the legal pages at all).
//
// Page-specific <head> extras (index's preloader CSS) go in the "head" slot.
const {
  title,
  description,
  canonical,
  ogType = 'website',
  ogTitle = title,
  ogDescription = description,
  themeColor = '#f4f6f7',
  bodyClass,
  script = true,
} = Astro.props;
import '../styles/site.css';
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<meta name="theme-color" content={themeColor}>

<title>{title}</title>
<meta name="description" content={description}>
<meta name="robots" content="all">
<link rel="canonical" href={canonical}>

<!-- Open Graph -->
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content="MetaFlux">
<meta property="og:url" content={canonical}>
<meta property="og:title" content={ogTitle}>
<meta property="og:description" content={ogDescription}>
<meta property="og:image" content="https://mtf.exchange/og.png">
<meta property="og:image:secure_url" content="https://mtf.exchange/og.png">
<meta property="og:image:type" content="image/png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="MetaFlux — Derivatives, on first principles.">
<meta property="og:locale" content="en_US">

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:site" content="@MetaFluxDex">
<meta name="twitter:title" content={ogTitle}>
<meta name="twitter:description" content={ogDescription}>
<meta name="twitter:image" content="https://mtf.exchange/og.png">
<meta name="twitter:image:alt" content="MetaFlux — Derivatives, on first principles.">

<!-- Icons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="alternate icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=PT+Serif:ital@1&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=PT+Serif:ital@1&display=swap" media="print" onload="this.media='all'">
<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500&family=Inter:wght@400;500&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&family=PT+Serif:ital@1&display=swap"></noscript>
<slot name="head" />
</head>
<body class={bodyClass}>
<slot />
{script && <script src="/main.js" is:inline></script>}
</body>
</html>
