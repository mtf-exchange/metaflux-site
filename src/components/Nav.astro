---
interface Props {
  current?: 'home' | 'tge' | 'whitepaper' | 'terms' | 'privacy';
  overlay?: boolean;
}
const { current, overlay = false } = Astro.props;
const links = [
  { href: '/#markets', text: 'Markets' },
  { href: '/tge.html', text: 'Points', page: 'tge' },
  { href: '/#build', text: 'Build' },
  { href: 'https://docs.mtf.exchange/', text: 'Docs' },
  { href: '/whitepaper.html', text: 'Whitepaper', page: 'whitepaper' },
];
const items = links.map((l) => ({ ...l, current: l.page === current ? 'page' : undefined }));
---
<nav class:list={['site', { overlay }]} aria-label="Main">
  <div class="wrap">
    <a class="brand" href="/" aria-label="MetaFlux home"><i class="mark" aria-hidden="true"></i><span>MetaFlux</span></a>
    <ul>
      {items.map((l) => <li><a href={l.href} aria-current={l.current}>{l.text}</a></li>)}
    </ul>
    <a class="pill solid" href="https://app.mtf.exchange/">Launch app</a>
    <details class="menu">
      <summary><span class="o">Menu</span><span class="c">Close</span></summary>
      <ul>
        {items.map((l) => <li><a href={l.href} aria-current={l.current}>{l.text}</a></li>)}
      </ul>
    </details>
  </div>
</nav>
